# Environment Variables for Spark GCP Automation
# Copy this to .env and customize for your setup
# NOTE: .env is gitignored for security

# === SSH Configuration ===
# Path to your GCP SSH private key
# Default: ~/.ssh/gcp_spark
SPARK_SSH_KEY=~/.ssh/gcp_spark

# === Optional: Ansible Configuration ===
# ANSIBLE_HOST_KEY_CHECKING=False  # Set by manage.py automatically
# ANSIBLE_FORCE_COLOR=true         # Set by manage.py automatically

# === Optional: GCP Project ===
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
# GOOGLE_CLOUD_PROJECT=your-project-id

# === Optional: Terraform Backend ===
# If using GCS backend, authenticate with:
# gcloud auth application-default login

# Usage:
# 1. Copy: cp .env.example .env
# 2. Edit .env with your values
# 3. Load: source .env  (or use direnv)
# 4. Run: ./manage.py
