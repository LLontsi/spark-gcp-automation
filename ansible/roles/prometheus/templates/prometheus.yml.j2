global:
  scrape_interval: 15s

scrape_configs:
  - job_name: 'node_exporter'
    static_configs:
      - targets:
{% if groups['master'] is defined %}
{% for host in groups['master'] %}
        - '{{ hostvars[host]["internal_ip"] | default(hostvars[host]["ansible_host"]) }}:9100'
{% endfor %}
{% endif %}
{% if groups['workers'] is defined %}
{% for host in groups['workers'] %}
        - '{{ hostvars[host]["internal_ip"] | default(hostvars[host]["ansible_host"]) }}:9100'
{% endfor %}
{% endif %}
{% if groups['edge'] is defined %}
{% for host in groups['edge'] %}
        - '{{ hostvars[host]["internal_ip"] | default(hostvars[host]["ansible_host"]) }}:9100'
{% endfor %}
{% endif %}
