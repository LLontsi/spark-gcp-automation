# Secure Terraform Variables Template
# Copy this to terraform.tfvars and customize for your environment
# DO NOT commit terraform.tfvars with real credentials!

# === REQUIRED: Set these values ===
project_id     = "your-gcp-project-id"
ssh_public_key = "ssh-rsa AAAAB3... your-key-here"

# === Region/Zone Configuration ===
region = "europe-west1"
zone   = "europe-west1-b"

# === Cluster Configuration ===
cluster_name = "spark"
num_workers  = 2  # Start small, scale as needed

# === Network Security (IMPORTANT!) ===
# Replace with YOUR IP addresses for production!
# Find your IP: curl ifconfig.me
allowed_ssh_ips = [
  "0.0.0.0/0"  # WARNING: Open to internet! Replace with your IPs
]

allowed_ui_ips = [
  "0.0.0.0/0"  # WARNING: Open to internet! Replace with your IPs
]

# Production example (uncomment and customize):
# allowed_ssh_ips = [
#   "203.0.113.0/24",    # Office network
#   "198.51.100.42/32",  # Your home IP
# ]
# allowed_ui_ips = [
#   "203.0.113.0/24",    # Office network
# ]

# === Instance Configuration ===
# Adjust based on workload requirements
# See: https://cloud.google.com/compute/docs/machine-types
machine_type_master = "n1-standard-4"  # 4 vCPU, 15 GB RAM
machine_type_worker = "n1-standard-4"  # 4 vCPU, 15 GB RAM
machine_type_edge   = "n1-standard-2"  # 2 vCPU, 7.5 GB RAM

disk_size = 50  # GB per instance

# === Advanced: SSH Configuration ===
ssh_user = "ansible"  # Default SSH username
